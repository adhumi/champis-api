# Copier en .env (ignoré par git) pour travailler en local ; Railway fournit ces variables au service.
# Les variables déjà présentes dans l'environnement priment sur ce fichier.

# Bucket Railway des PMTiles — préréglage « AWS SDK (Generic) » de Connect Service to Bucket
AWS_ENDPOINT_URL=https://storage.railway.app
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# API météo (champis-api warm / uvicorn en local)
CHAMPIS_OPEN_METEO_API_KEY=

# Observations et coins : Postgres Railway (DATABASE_URL injectée par le service Postgres) ;
# en local, sans valeur, une base SQLite data/champis.db est utilisée
# DATABASE_URL=postgresql+psycopg://user:motdepasse@hote:5432/railway

# Notifications « mes coins » (APNs, clé .p8 d'App Store Connect ; contenu PEM ou chemin du fichier)
# CHAMPIS_APNS_KEY=
# CHAMPIS_APNS_KEY_ID=
# CHAMPIS_APNS_TEAM_ID=
# CHAMPIS_APNS_TOPIC=fr.adhumi.champis
# CHAMPIS_NOTIFY_HOURS=7
# CHAMPIS_TILES_MODE=presign
# CHAMPIS_WARM_HOURS=

# Climate Data Store (champis-pipeline soil-clim) : https://cds.climate.copernicus.eu → votre profil
# CDSAPI_URL=https://cds.climate.copernicus.eu/api
# CDSAPI_KEY=
