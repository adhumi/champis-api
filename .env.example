# Copier en .env (ignoré par git) pour travailler en local ; Railway fournit ces variables au service.
# Les variables déjà présentes dans l'environnement priment sur ce fichier.

# Bucket Railway des PMTiles — préréglage « AWS SDK (Generic) » de Connect Service to Bucket
AWS_ENDPOINT_URL=https://storage.railway.app
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# API météo (champis-api warm / uvicorn en local)
CHAMPIS_OPEN_METEO_API_KEY=
# CHAMPIS_TILES_MODE=presign
# CHAMPIS_WARM_HOURS=
